# CreatorOS local development environment
# Copy to .env and adjust. Never commit real secrets.

APP_ENV=development
APP_NAME=creatoros-api
APP_VERSION=0.1.0

# Local host URLs (inside Docker Compose, services override hostnames)
DATABASE_URL=postgresql+psycopg://creatoros:creatoros@localhost:5432/creatoros
REDIS_URL=redis://localhost:6379/0

# Generate a unique value before any non-local deployment.
SECRET_KEY=replace-this

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI (unused in Milestone 1; required later)
AI_API_KEY=
AI_MODEL=

# S3-compatible storage (unused in Milestone 1)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
