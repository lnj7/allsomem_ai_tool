# CreatorOS local development environment
# Copy to .env and adjust. Never commit real secrets.

APP_ENV=development
APP_NAME=creatoros-api
APP_VERSION=0.1.0

# Use localhost when running services on the host.
# Docker Compose overrides hostnames to postgres/redis for the API container.
DATABASE_URL=postgresql+psycopg://creatoros:creatoros@localhost:5432/creatoros
REDIS_URL=redis://localhost:6379/0

# Generate a unique value before any non-local deployment.
SECRET_KEY=replace-this

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
# Leave empty so the browser calls this same website (/api, /health). Next.js proxies to the API.
NEXT_PUBLIC_API_URL=

# OpenAI-compatible chat API (Bearer token to {AI_BASE_URL}/chat/completions).
# Never commit a real key. Copy to .env and paste your secret.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# YouTube / Google OAuth (official). Leave empty to show "YouTube integration is not configured."
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/social-accounts/oauth/youtube/callback

# Instagram + Facebook Pages via Meta Graph API. Never put user passwords here.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/social-accounts/oauth/meta/callback

# S3-compatible storage (unused in Milestone 1)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
